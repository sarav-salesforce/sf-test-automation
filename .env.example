# Salesforce Connected App consumer key (JWT issuer)
SF_CONSUMER_KEY=

# Salesforce username approved for the Connected App
SF_USERNAME=

# Production is the default. Use https://test.salesforce.com for a sandbox.
SF_LOGIN_URL=https://login.salesforce.com
# Alternatively omit SF_LOGIN_URL and set SF_SANDBOX=true.
SF_SANDBOX=false

# PKCS#8 PEM private key whose certificate is uploaded to the Connected App
SF_PRIVATE_KEY_PATH=cert/server-pkcs8.key
